# =============================================================================
# AI Testing System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM API Keys (at least one required)
# ---------------------------------------------------------------------------
# DeepSeek
DEEPSEEK_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Backend — Model Config
# ---------------------------------------------------------------------------
# LLM provider: deepseek | openai
MODEL_PROVIDER=deepseek

# Model name for the chosen provider
MODEL_NAME=deepseek-chat

# ---------------------------------------------------------------------------
# Backend — CORS
# Comma-separated list of allowed frontend origins.
# Default covers localhost and the common Docker bridge IP.
# Add any additional origins you need (e.g. your domain).
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://172.16.187.149:3000

# ---------------------------------------------------------------------------
# Backend — Playwright
# Path where Chromium binaries are stored (default: /ms-playwright)
# ---------------------------------------------------------------------------
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ---------------------------------------------------------------------------
# Frontend — API base path
# This is baked into the Docker image at build time via --build-arg.
# The /api/v1 path is rewritten to the backend by Next.js rewrites,
# so the browser always talks to the same origin (no CORS needed).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=/api/v1

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Timezone for log timestamps and DB operations
TZ=Asia/Shanghai

# Which port the frontend is reachable on from the host.
# Default: 3000.  Change to 3001, 8080, etc. if 3000 is busy.
FRONTEND_PORT=3000
