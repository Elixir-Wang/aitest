+def _terminal_event_title(event_type: str) -> str:
+    if event_type == "run_completed":
+        return "探索完成"
+    if event_type == "run_failed":
+        return "探索失败"
+    if event_type == "run_cancelled":
+        return "探索停止"
+    return "探索结束"
